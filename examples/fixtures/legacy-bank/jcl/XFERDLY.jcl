//XFERDLY  JOB (FIN,8823),'DAILY XFER POST',CLASS=P,MSGCLASS=X,
//         NOTIFY=&SYSUID,REGION=0M
//*--------------------------------------------------------------------
//* MERIDIAN SAVINGS BANK - NIGHTLY TRANSFER POSTING
//*
//* STEP010  SORT THE MERGED CHANNEL FILE (BRN/ATM/TEL) BY SOURCE
//*          ACCOUNT THEN SEQUENCE NO, DROPPING BLANK RECORDS.
//* STEP020  RUN ACCTXFR AGAINST DB2P.  POSTS TRANSFERS, WRITES
//*          REJECTS TO MERID.XFER.REJECTS(+1).
//*
//* RESTART NOTES:
//*   ACCTXFR COMMITS EVERY 100 POSTED TRANSFERS.  AFTER AN ABEND,
//*   DO NOT SIMPLY RESUBMIT - ALREADY-COMMITTED TRANSFERS WOULD
//*   POST TWICE.  OPS PROCEDURE: PULL THE LAST SEQ NO FROM THE
//*   ABEND SYSOUT, STRIP PROCESSED RECORDS FROM XFERIN, RERUN
//*   FROM STEP020.  STEP020 ONLY RUNS IF STEP010 RC .LE. 4.
//*--------------------------------------------------------------------
//STEP010  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=MERID.XFER.DAILY.MERGED(0),DISP=SHR
//SORTOUT  DD DSN=MERID.XFER.DAILY.SORTED,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(8,10,CH,A,1,7,CH,A)
  OMIT COND=(1,7,CH,EQ,C'       ')
/*
//*--------------------------------------------------------------------
//STEP020  EXEC PGM=IKJEFT01,COND=(4,LT,STEP010)
//STEPLIB  DD DSN=MERID.PROD.LOADLIB,DISP=SHR
//         DD DSN=DSN.DB2P.SDSNLOAD,DISP=SHR
//XFERIN   DD DSN=MERID.XFER.DAILY.SORTED,DISP=SHR
//REJECTS  DD DSN=MERID.XFER.REJECTS(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(2,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSTSPRT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(ACCTXFR) PLAN(ACCTXFR) -
      LIB('MERID.PROD.LOADLIB')
  END
/*
//
